<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nv_surface_container_high"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_add_queue_tab_tracks"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_primary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/queue_add_tab_tracks"
            android:textAllCaps="false"
            android:textColor="@color/nv_on_primary_container"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_add_queue_tab_playlists"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_surface"
            android:fontFamily="sans-serif-medium"
            android:text="@string/queue_add_tab_playlists"
            android:textAllCaps="false"
            android:textColor="@color/nv_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_add_queue_filter"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_surface"
        android:hint="@string/search_hint"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="@color/nv_on_surface"
        android:textColorHint="@color/nv_outline"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/list_add_queue_items"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="12dp"
        android:divider="@color/nv_transparent"
        android:dividerHeight="4dp" />
</LinearLayout>
