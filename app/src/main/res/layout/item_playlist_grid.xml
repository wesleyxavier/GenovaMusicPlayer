<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_surface"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <ImageView
            android:id="@+id/iv_playlist_grid_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_album_art_thumb"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:padding="20dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_queue"
            android:tint="@color/nv_primary" />

        <TextView
            android:id="@+id/tv_playlist_grid_pinned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_hifi"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="@string/playlist_pinned_badge"
            android:textColor="@color/nv_primary"
            android:textSize="9sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_playlist_grid_play"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_pill_primary"
            android:contentDescription="@string/cd_playlist_quick_play"
            android:focusable="false"
            android:padding="12dp"
            android:src="@drawable/ic_play"
            android:tint="@color/nv_on_primary_container" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_playlist_grid_name"
                style="@style/TextTitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_playlist_grid_count"
                style="@style/TextLabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_playlist_grid_more"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_playlist_options"
            android:focusable="false"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/nv_on_surface_variant" />
    </LinearLayout>
</LinearLayout>
