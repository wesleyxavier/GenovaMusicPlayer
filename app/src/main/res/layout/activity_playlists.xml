<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nv_surface"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_queue"
            android:tint="@color/nv_primary" />

        <TextView
            style="@style/TextTitleLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/playlists_title" />

        <ImageButton
            android:id="@+id/btn_search_playlists"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_search_button"
            android:padding="12dp"
            android:src="@drawable/ic_search"
            android:tint="@color/nv_on_surface" />
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_input_height"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_pill_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="@color/nv_outline" />

        <EditText
            android:id="@+id/et_playlists_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/playlists_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/nv_on_surface"
            android:textColorHint="@color/nv_outline"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Create New Playlist Highlight Card -->
    <LinearLayout
        android:id="@+id/card_create_playlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card_surface_high"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_primary"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            android:tint="@color/nv_on_primary_container" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextTitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playlist_create_card_title"
                android:textSize="15sp" />

            <TextView
                style="@style/TextLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playlist_create_card_subtitle"
                android:textColor="@color/nv_on_surface_variant" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_create_playlist"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_pill_surface"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/playlist_create_card_cta"
            android:textAllCaps="false"
            android:textColor="@color/nv_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Section Header: Minhas Playlists + Sort + Grid/List Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextTitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/playlists_section_mine" />

        <Button
            android:id="@+id/btn_playlists_sort"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_pill_surface"
            android:contentDescription="@string/cd_playlist_sort"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/playlist_sort_recent"
            android:textAllCaps="false"
            android:textColor="@color/nv_on_surface_variant"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_playlists_toggle_view"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_playlist_view_list"
            android:padding="12dp"
            android:src="@drawable/ic_grid_view"
            android:tint="@color/nv_primary" />
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_playlists_empty"
            style="@style/TextBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/playlists_empty"
            android:visibility="gone" />

        <GridView
            android:id="@+id/grid_playlists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:horizontalSpacing="10dp"
            android:numColumns="2"
            android:verticalSpacing="10dp" />

        <ListView
            android:id="@+id/list_playlists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:divider="@color/nv_transparent"
            android:dividerHeight="8dp"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <!-- Smart System Playlists -->
        <TextView
            style="@style/TextTitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/playlists_section_smart"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_smart_most_played"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/TextTitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/smart_most_played_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_smart_most_played_count"
                    style="@style/TextLabelSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 músicas"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_smart_recently_added"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/TextTitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/smart_recently_added_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_smart_recent_count"
                    style="@style/TextLabelSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 músicas"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/include_mini_player" />

    <!-- Bottom Navigation (3 Tabs) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/nv_surface_container_low"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_music"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/cd_tab_music"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                android:tint="@color/nv_outline" />

            <TextView
                style="@style/TextLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_music"
                android:textColor="@color/nv_outline" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_playlists"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/cd_tab_playlists"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_queue"
                android:tint="@color/nv_primary" />

            <TextView
                style="@style/TextLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_playlists"
                android:textColor="@color/nv_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_folders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/cd_tab_folders"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder"
                android:tint="@color/nv_outline" />

            <TextView
                style="@style/TextLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_folders"
                android:textColor="@color/nv_outline" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
