<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nv_surface"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_music_note"
            android:tint="@color/nv_primary" />

        <TextView
            style="@style/TextTitleLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/playlists_title" />

        <ImageButton
            android:id="@+id/btn_search_playlists"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_search_button"
            android:padding="12dp"
            android:src="@drawable/ic_search"
            android:tint="@color/nv_on_surface" />
    </LinearLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btn_create_playlist"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cta_button_height"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill_primary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/action_create_playlist"
            android:textAllCaps="false"
            android:textColor="@color/nv_on_primary_container"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_playlists_empty"
            style="@style/TextBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/playlists_empty"
            android:visibility="gone" />

        <ListView
            android:id="@+id/list_playlists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:divider="@color/nv_transparent"
            android:dividerHeight="8dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- Bottom Navigation (3 Tabs) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/nv_surface_container_low"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_music"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/cd_tab_music"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                android:tint="@color/nv_outline" />

            <TextView
                style="@style/TextLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_music"
                android:textColor="@color/nv_outline" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_playlists"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/cd_tab_playlists"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_queue"
                android:tint="@color/nv_primary" />

            <TextView
                style="@style/TextLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_playlists"
                android:textColor="@color/nv_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_folders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/cd_tab_folders"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder"
                android:tint="@color/nv_outline" />

            <TextView
                style="@style/TextLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_folders"
                android:textColor="@color/nv_outline" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
