<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nv_surface_container_high"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/frame_create_playlist_art"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_album_art_glow">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                android:tint="@color/nv_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_create_playlist_art_style"
            style="@style/TextLabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/playlist_auto_art_label"
            android:textColor="@color/nv_on_surface" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextLabelSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/playlist_name_hint"
            android:textColor="@color/nv_primary" />

        <TextView
            android:id="@+id/tv_create_playlist_counter"
            style="@style/TextLabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/60" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_create_playlist_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_surface"
        android:hint="@string/playlist_name_hint"
        android:inputType="textCapSentences"
        android:maxLength="60"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="@color/nv_on_surface"
        android:textColorHint="@color/nv_outline"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_surface"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pin"
            android:tint="@color/nv_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextTitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playlist_pin_toggle_title"
                android:textSize="14sp" />

            <TextView
                style="@style/TextLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playlist_pin_toggle_subtitle"
                android:textSize="11sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/switch_create_playlist_pin"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:contentDescription="@string/playlist_pin_toggle_title" />
    </LinearLayout>
</LinearLayout>
