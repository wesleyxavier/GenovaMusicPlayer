<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_surface"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_album_art_thumb"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_queue"
        android:tint="@color/nv_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_playlist_name"
            style="@style/TextTitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_playlist_count"
            style="@style/TextLabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nv_on_surface_variant" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_playlist_more"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_playlist_options"
        android:focusable="false"
        android:padding="12dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/nv_on_surface_variant" />
</LinearLayout>
