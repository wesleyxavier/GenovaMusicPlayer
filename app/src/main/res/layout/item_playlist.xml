<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_card_surface"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/iv_playlist_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_album_art_thumb"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:padding="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_queue"
        android:tint="@color/nv_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_playlist_name"
                style="@style/TextTitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_playlist_pinned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_hifi"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/playlist_pinned_badge"
                android:textColor="@color/nv_primary"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_playlist_count"
            style="@style/TextLabelSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nv_on_surface_variant" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_playlist_quick_play"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_playlist_quick_play"
        android:focusable="false"
        android:padding="12dp"
        android:src="@drawable/ic_play"
        android:tint="@color/nv_primary" />

    <ImageButton
        android:id="@+id/btn_playlist_more"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_playlist_options"
        android:focusable="false"
        android:padding="12dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/nv_on_surface_variant" />
</LinearLayout>
