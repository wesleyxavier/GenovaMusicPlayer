<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_card_surface"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/tv_queue_item_pos"
        style="@style/TextLabelSmall"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/nv_on_surface_variant" />

    <ImageView
        android:id="@+id/iv_queue_item_art"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_album_art_thumb"
        android:clipToOutline="true"
        android:contentDescription="@string/cd_track_art"
        android:padding="6dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_queue_item_title"
            style="@style/TextTitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_queue_item_subtitle"
            style="@style/TextLabelSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nv_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_queue_item_more"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_track_options"
        android:focusable="false"
        android:padding="12dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/nv_on_surface_variant" />

    <ImageButton
        android:id="@+id/btn_queue_item_drag"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_queue_drag"
        android:focusable="false"
        android:padding="12dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/nv_outline" />
</LinearLayout>
