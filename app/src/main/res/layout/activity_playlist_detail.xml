<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nv_surface"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btn_playlist_back"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/nv_on_surface" />

        <TextView
            android:id="@+id/tv_playlist_detail_badge"
            style="@style/TextLabelSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/playlist_personal_badge"
            android:textColor="@color/nv_primary" />

        <ImageButton
            android:id="@+id/btn_playlist_share"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_share"
            android:padding="12dp"
            android:src="@drawable/ic_share"
            android:tint="@color/nv_on_surface" />

        <ImageButton
            android:id="@+id/btn_playlist_detail_more"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_playlist_options"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/nv_on_surface" />
    </LinearLayout>

    <!-- Playlist Hero Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/iv_playlist_detail_art"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_album_art_glow"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:padding="16dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_queue"
            android:tint="@color/nv_primary" />

        <TextView
            android:id="@+id/tv_playlist_detail_title"
            style="@style/TextTitleLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tv_playlist_detail_count"
            style="@style/TextLabelSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/nv_on_surface_variant" />

        <!-- Primary Play & Shuffle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_playlist_play"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_pill_primary"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/action_play"
                android:textAllCaps="false"
                android:textColor="@color/nv_on_primary_container"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_playlist_shuffle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_surface"
                android:drawableStart="@drawable/ic_shuffle"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/action_shuffle_all"
                android:textAllCaps="false"
                android:textColor="@color/nv_on_surface"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <Button
                android:id="@+id/btn_playlist_add_tracks"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_pill_surface"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/playlist_add_tracks_button"
                android:textAllCaps="false"
                android:textColor="@color/nv_on_surface"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_playlist_manual_order"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_surface"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/playlist_manual_order_button"
                android:textAllCaps="false"
                android:textColor="@color/nv_on_surface"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_playlist_add_to_queue"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_surface"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/playlist_add_to_queue_button"
                android:textAllCaps="false"
                android:textColor="@color/nv_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Internal Filter -->
    <EditText
        android:id="@+id/et_playlist_filter"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_pill_surface"
        android:hint="@string/playlist_filter_tracks_hint"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="@color/nv_on_surface"
        android:textColorHint="@color/nv_outline"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_playlist_detail_empty"
        style="@style/TextBodyMedium"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/playlist_detail_empty"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list_playlist_tracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@color/nv_transparent"
        android:dividerHeight="2dp"
        android:fastScrollEnabled="true"
        android:paddingStart="8dp"
        android:paddingEnd="4dp" />

    <include layout="@layout/include_mini_player" />
</LinearLayout>
