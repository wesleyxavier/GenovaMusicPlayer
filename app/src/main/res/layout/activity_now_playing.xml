<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nv_surface"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Top App Bar (no Profile icon per Q3: B) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/nv_on_surface" />

        <TextView
            style="@style/TextTitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/now_playing_title" />

        <ImageButton
            android:id="@+id/btn_now_playing_more"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_now_playing_options"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/nv_on_surface" />
    </LinearLayout>

    <!-- Center Album Art with Subtle Lavender Glow -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <View
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_album_art_glow" />

        <ImageView
            android:id="@+id/iv_album_art_large"
            android:layout_width="272dp"
            android:layout_height="272dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_card_surface"
            android:clipToOutline="true"
            android:contentDescription="@string/cd_album_art_large"
            android:padding="56dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note" />
    </FrameLayout>

    <!-- Lower Half Ergonomic Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hi-Fi Badge -->
        <TextView
            android:id="@+id/tv_hifi_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_badge_hifi"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/badge_hifi"
            android:textColor="@color/nv_primary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Title, Artist + Share (No Favorite per Q2: B) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_np_title"
                    style="@style/TextTitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/playback_error_no_track" />

                <TextView
                    android:id="@+id/tv_np_artist"
                    style="@style/TextBodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_share"
                android:padding="12dp"
                android:src="@drawable/ic_share"
                android:tint="@color/nv_on_surface" />
        </LinearLayout>

        <!-- Error Banner (only when ERROR) -->
        <TextView
            android:id="@+id/tv_np_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/nv_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- SeekBar & Elapsed / Total Time -->
        <SeekBar
            android:id="@+id/seek_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/cd_seekbar"
            android:minHeight="36dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_elapsed_time"
                style="@style/TextLabelSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/time_zero" />

            <TextView
                android:id="@+id/tv_total_time"
                style="@style/TextLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_zero" />
        </LinearLayout>

        <!-- Transport Controls (Shuffle, Prev, Play/Pause 64dp, Next, Repeat) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_shuffle"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_shuffle"
                    android:padding="12dp"
                    android:src="@drawable/ic_shuffle"
                    android:tint="@color/nv_on_surface_variant" />

                <View
                    android:id="@+id/dot_shuffle"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_pill_primary"
                    android:visibility="invisible" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_previous"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginEnd="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_previous"
                android:padding="10dp"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/nv_on_surface" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="@dimen/play_pause_button_size"
                android:layout_height="@dimen/play_pause_button_size"
                android:background="@drawable/bg_pill_primary"
                android:contentDescription="@string/cd_play_pause"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="@color/nv_on_primary_container" />

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_next"
                android:padding="10dp"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/nv_on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_repeat"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_repeat"
                    android:padding="12dp"
                    android:src="@drawable/ic_repeat"
                    android:tint="@color/nv_on_surface_variant" />

                <View
                    android:id="@+id/dot_repeat"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_pill_primary"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Audio Output Route Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_speaker"
                android:tint="@color/nv_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_output_label" />

                <TextView
                    android:id="@+id/tv_audio_output"
                    style="@style/TextTitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_output_speaker"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_switch_output"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_pill_surface"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/action_switch_output"
                android:textAllCaps="false"
                android:textColor="@color/nv_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Footer Placeholders (Inactive "Em breve" per Q1: B) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_queue_placeholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:alpha="0.55"
                android:background="@drawable/bg_card_surface"
                android:clickable="true"
                android:contentDescription="@string/action_queue_next"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_queue"
                    android:tint="@color/nv_on_surface_variant" />

                <TextView
                    style="@style/TextLabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/action_queue_next"
                    android:textColor="@color/nv_on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/coming_soon_badge"
                    android:textColor="@color/nv_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_lyrics_placeholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:alpha="0.55"
                android:background="@drawable/bg_card_surface"
                android:clickable="true"
                android:contentDescription="@string/action_view_lyrics"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lyrics"
                    android:tint="@color/nv_on_surface_variant" />

                <TextView
                    style="@style/TextLabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/action_view_lyrics"
                    android:textColor="@color/nv_on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/coming_soon_badge"
                    android:textColor="@color/nv_primary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
